# Private service project (separate from the destination).
IMPORT_JOB_DATABASE_URL=
IMPORT_JOB_SUPABASE_URL=
IMPORT_JOB_SERVICE_ROLE_KEY=
# Stable 32-byte encryption key, base64 encoded. Generate: openssl rand -base64 32
IMPORT_CREDENTIAL_KEY=

# Required platform OAuth. See OAUTH_SETUP.md; never use NEXT_PUBLIC_ for these.
IMPORT_OAUTH_CLIENT_ID=
IMPORT_OAUTH_CLIENT_SECRET=
IMPORT_OAUTH_REDIRECT_URI=http://localhost:3009/migrate/instantdb/api/supabase/callback

# Optional anonymous product analytics. Use an existing PostHog project or create one first.
# Keep these server-only. Production Vercel deployments are the only default emitters.
IMPORT_POSTHOG_KEY=
IMPORT_POSTHOG_HOST=
# Explicit local/preview opt-in, intended only for a separate test PostHog project.
# IMPORT_TELEMETRY_DEV=1
