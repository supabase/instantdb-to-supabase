# Private service project (separate from the destination).
IMPORT_JOB_DATABASE_URL=
IMPORT_JOB_SUPABASE_URL=
IMPORT_JOB_SERVICE_ROLE_KEY=
# Stable 32-byte encryption key, base64 encoded. Generate: openssl rand -base64 32
IMPORT_CREDENTIAL_KEY=

# Required platform OAuth. See "OAuth configuration" in README.md; never use NEXT_PUBLIC_ for these.
IMPORT_OAUTH_CLIENT_ID=
IMPORT_OAUTH_CLIENT_SECRET=
IMPORT_OAUTH_REDIRECT_URI=http://localhost:3009/migrate/instantdb/api/supabase/callback

# Optional PostHog analytics. Use your own project. Production Vercel deployments only, unless IMPORT_TELEMETRY_DEV=1.
# Browser events always go to https://ph.supabase.com. IMPORT_POSTHOG_HOST sets the destination for server events only, but both values are needed to turn analytics on.
IMPORT_POSTHOG_KEY=
IMPORT_POSTHOG_HOST=
# Explicit local/preview opt-in, intended only for a separate test PostHog project.
# IMPORT_TELEMETRY_DEV=1

# First-party usage log (public.usage_events in the service project). On by default; set to 0 to disable.
# Not affected by Do Not Track or Global Privacy Control.
# Records the event name, environment, job ID, destination project ref, counts, stages, elapsed time, fixed failure codes and UI action types.
# It stores no user ID, IP address, user agent or URL. A project ref can be linked to its owning Supabase account by Supabase.
# IMPORT_USAGE_LOG=0
