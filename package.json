{
  "name": "instantdb-to-supabase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3009",
    "build": "next build --webpack",
    "start": "next start --port 3009",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:db": "supabase test db",
    "test:integration": "vitest run tests/oauth-credentials.integration.test.ts tests/restore.integration.test.ts tests/permissions.integration.test.ts tests/workflow.integration.test.ts",
    "test:coverage": "vitest run --coverage --exclude '**/*.integration.test.ts'",
    "import": "node --import tsx scripts/import.ts",
    "clean": "rimraf .next .turbo coverage tsconfig.tsbuildinfo .workflow-data app/.well-known/workflow test-results playwright-report artifacts",
    "import:workflow": "node --import tsx scripts/workflow-import.ts",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "test:prettier": "prettier --check .",
    "vendor:check": "node scripts/sync-vendor.mjs --check",
    "vendor:sync": "node scripts/sync-vendor.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "3.3.1",
    "@supabase/pg-meta": "workspace:*",
    "@supabase/supabase-js": "2.112.4",
    "@tailwindcss/postcss": "4.2.4",
    "@workflow/core": "5.0.0-beta.47",
    "config": "workspace:*",
    "fflate": "0.8.2",
    "hash-wasm": "4.12.0",
    "lucide-react": "0.436.0",
    "next": "16.3.4",
    "pg": "8.16.3",
    "pluralize": "8.0.0",
    "posthog-js": "1.438.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.72.1",
    "tailwindcss": "4.2.4",
    "tus-js-client": "4.1.0",
    "ui": "workspace:*",
    "ui-patterns": "workspace:*",
    "workflow": "5.0.0-beta.47",
    "zod": "3.25.76",
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/forms": "0.5.11",
    "tw-animate-css": "1.4.0",
    "next-themes": "0.4.6",
    "class-variance-authority": "0.7.1",
    "radix-ui": "1.4.3",
    "framer-motion": "11.18.2",
    "clsx": "2.1.1",
    "tailwind-merge": "3.5.0",
    "lodash": "4.18.1",
    "sonner": "1.5.0",
    "highlightjs-curl": "1.3.0",
    "react-syntax-highlighter": "15.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "22.13.14",
    "@types/pg": "8.11.11",
    "@types/pluralize": "0.0.33",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.4",
    "rimraf": "6.0.1",
    "tsx": "4.22.4",
    "typescript": "6.0.2",
    "vitest": "4.1.4",
    "prettier": "3.8.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.0",
    "prettier-plugin-sql-cst": "0.18.0",
    "eslint": "9.37.0",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "10.1.8",
    "@typescript-eslint/parser": "8.48.0",
    "@types/lodash": "4.17.5",
    "@types/react-syntax-highlighter": "15.5.13"
  },
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.13"
  }
}
